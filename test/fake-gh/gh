#!/usr/bin/env node
// A stand-in for the gh binary in tests. It answers the reads Gary makes from test/fixtures/github.mjs
// and refuses every write, so no test can reach GitHub.
//   FAKE_GH_WRITES         a file. With it the fake accepts the mutations of the fix review rounds, a Copilot
//                          review request, marking a PR ready and a review request for the maintainer, a PR review, a
//                          discussion comment, the commit and the comment of an API edit, and the edit of a PR's body, and
//                          appends one line per accepted write. A `writeError` in
//                          FAKE_GH_OVERRIDES makes such a write fail with that message, and a `branchHead` there is the
//                          head a commit must expect
//   GH_TOKEN               the bot token from the fixtures logs in as the bot, any other token as "someone-else"
//   FAKE_GH_LOGIN          the stored login without GH_TOKEN, default octocat. Empty means not logged in
//   FAKE_GH_REPO_ACCESS    what a read of repos/<owner>/<name> answers for a repo of the fixture owner: "push" (default), "read",
//                          or "none" for a 404
//   FAKE_GH_LOG            a file that gets one line per call, for tests that check what ran
//   FAKE_GH_NO_PROJECTS    "1" makes every read of GitHub Projects fail like a token without the read:project scope.
//                          A node's `projectItems` reach only a query that asks for them
//   FAKE_GH_OVERRIDES      a JSON file { "issue-22": { …fields } } merged into the full nodes of `gary item`, read on every call.
//                          "requests-<n>" is merged into the PR that a review request for the maintainer reads.
//                          "escalation-<n>" is the closed discussion, "escalated-issue-<n>" the issue and "link-pr-<n>"
//                          the PR that `gary link-escalated` reads
//   FAKE_GH_CONTRIBUTIONS  a JSON file { searches: [{ match, nodes, total }], items: { "owner/name#n": node } } for a
//                          contributions instance. A search answers with the nodes of the first entry whose `match`
//                          occurs in its query, paged by `first` and `after`. ContributionsItem reads `items`.
//                          `notifications: [{ id, unread, repo, subject }]` is the inbox, read per repo. Marking one
//                          as done needs FAKE_GH_WRITES and appends `{ notificationDone: id }` there. `reviewTargets:
//                          { "owner/name#n": { …PR node, files: [{ filename, patch }] } }` answers the read before a pending
//                          review (PendingReviewTarget) and the PR's changed files. `ownPrs: { "owner/name#n": node }`
//                          answers the read of the maintainer's own PR (ContributionsOwnPr), its branch and its commits
import { createHash } from "node:crypto";
import { appendFileSync, readFileSync } from "node:fs";
import * as gh from "../fixtures/github.mjs";

const args = process.argv.slice(2);
const stdin = args.includes("-") ? readFileSync(0, "utf8") : "";
if (process.env.FAKE_GH_LOG) appendFileSync(process.env.FAKE_GH_LOG, JSON.stringify({ args, stdin, token: !!process.env.GH_TOKEN }) + "\n");

function out(data) {
	process.stdout.write(JSON.stringify(data) + "\n");
	process.exit(0);
}

function fail(message, data) {
	if (data !== undefined) process.stdout.write(JSON.stringify({ data, errors: [{ type: "NOT_FOUND", message }] }) + "\n");
	process.stderr.write(`gh: ${message}\n`);
	process.exit(1);
}

if (args[0] === "--version") {
	process.stdout.write("gh version 0.0.0 (fake)\n");
	process.exit(0);
}
if (args[0] !== "api") fail(`fake gh does not support "${args.join(" ")}"`, undefined);

if (args[1] === "user") {
	if (process.env.GH_TOKEN) {
		process.stdout.write((process.env.GH_TOKEN === gh.BOT_TOKEN ? gh.BOT : "someone-else") + "\n");
		process.exit(0);
	}
	const login = process.env.FAKE_GH_LOGIN ?? gh.ME;
	if (!login) {
		process.stderr.write("To get started with GitHub CLI, please run:  gh auth login\n");
		process.exit(4);
	}
	process.stdout.write(login + "\n");
	process.exit(0);
}

if (args[1] !== "graphql") {
	const done = /^notifications\/threads\/(\d+)$/.exec(args[1]);
	if (done && args[args.indexOf("--method") + 1] === "DELETE" && process.env.FAKE_GH_WRITES) {
		appendFileSync(process.env.FAKE_GH_WRITES, JSON.stringify({ notificationDone: done[1] }) + "\n");
		process.exit(0);
	}
	if (args.includes("-X") || args.includes("--method")) fail("fake gh refuses every write", undefined);
	const inbox = /^repos\/([^/]+\/[^/]+)\/notifications\?/.exec(args[1]);
	if (inbox) {
		const data = process.env.FAKE_GH_CONTRIBUTIONS ? JSON.parse(readFileSync(process.env.FAKE_GH_CONTRIBUTIONS, "utf8")) : {};
		out((data.notifications ?? []).filter((n) => n.repo === inbox[1]));
	}
	const prFiles = /^repos\/([^/]+\/[^/]+)\/pulls\/(\d+)\/files\?/.exec(args[1]);
	if (prFiles) {
		const data = process.env.FAKE_GH_CONTRIBUTIONS ? JSON.parse(readFileSync(process.env.FAKE_GH_CONTRIBUTIONS, "utf8")) : {};
		const files = data.reviewTargets?.[`${prFiles[1]}#${prFiles[2]}`]?.files ?? [];
		out(args.includes("--slurp") ? [files] : files);
	}
	const m = /^repos\/[^/]+\/[^/]+\/actions\/runs\?head_sha=([0-9a-f]{40})/.exec(args[1]);
	if (m) out({ workflow_runs: gh.runs[m[1]] ?? [] });
	const repo = /^repos\/([^/]+)\/([^/?]+)$/.exec(args[1]);
	if (repo) {
		const access = process.env.FAKE_GH_REPO_ACCESS ?? "push";
		if (access === "none" || repo[1].toLowerCase() !== gh.OWNER) fail("Not Found (HTTP 404)", undefined);
		const push = access === "push";
		out({ full_name: `${repo[1]}/${repo[2]}`, permissions: { admin: false, maintain: false, push, triage: push, pull: true } });
	}
	fail(`fake gh has no answer for ${args[1]}`, undefined);
}

const { query, variables: v = {} } = JSON.parse(stdin || "{}");
if (/^\s*mutation\b/.test(query)) {
	const accepted = [
		["requestCopilotCodeReview", { requestCopilotCodeReview: { success: true, failureReason: null } }],
		["markPullRequestReadyForReview", { markPullRequestReadyForReview: { pullRequest: { url: `${gh.URL}/pull/0` } } }],
		["requestReviews(", { requestReviews: { pullRequest: { url: `${gh.URL}/pull/${String(v.id).replace("PR_", "")}` } } }],
		["addPullRequestReview", { addPullRequestReview: { pullRequestReview: { url: `${gh.URL}/pull/${String(v.id).replace("PR_", "")}#pullrequestreview-777` } } }],
		["createCommitOnBranch", { createCommitOnBranch: { commit: { oid: gh.NEW_HEAD, url: `${gh.URL}/commit/${gh.NEW_HEAD}` } } }],
		["addComment(", { addComment: { commentEdge: { node: { url: `${gh.URL}/pull/${String(v.id).replace("PR_", "")}#issuecomment-950` } } } }],
		["updatePullRequest(", { updatePullRequest: { pullRequest: { url: `${gh.URL}/pull/${String(v.id).replace("PR_", "")}` } } }],
		["addDiscussionComment", { addDiscussionComment: { comment: { url: `${gh.URL}/discussions/${String(v.id).replace("D_", "")}#discussioncomment-900` } } }],
	].find(([name]) => query.includes(name));
	if (!process.env.FAKE_GH_WRITES || !accepted) fail("fake gh refuses every write", undefined);
	let writeError;
	let branchHead;
	try {
		({ writeError, branchHead } = JSON.parse(readFileSync(process.env.FAKE_GH_OVERRIDES, "utf8")));
	} catch {
		// No overrides
	}
	const name = accepted[0].replace("(", "");
	if (writeError) fail(writeError, { [name]: null });
	// GitHub refuses a commit whose expected head is not the branch's head
	const expected = v.input?.expectedHeadOid;
	if (name === "createCommitOnBranch" && branchHead && expected !== branchHead) fail(`Expected branch to point to "${expected}" but it did not. Pull and try again.`, { [name]: null });
	appendFileSync(process.env.FAKE_GH_WRITES, JSON.stringify({ mutation: name, variables: v, as: process.env.GH_TOKEN ? (process.env.GH_TOKEN === gh.BOT_TOKEN ? gh.BOT : "someone-else") : (process.env.FAKE_GH_LOGIN ?? gh.ME) }) + "\n");
	out({ data: accepted[1] });
}
const repository = (data) => out({ data: { repository: data } });
const overrides = (() => {
	try {
		return process.env.FAKE_GH_OVERRIDES ? JSON.parse(readFileSync(process.env.FAKE_GH_OVERRIDES, "utf8")) : {};
	} catch {
		return {};
	}
})();
const withProjects = (node) => {
	if (!node || query.includes("projectItems")) return node;
	const { projectItems, ...rest } = node;
	return rest;
};
const withOverride = (key, node) => withProjects(node && overrides[key] ? { ...node, ...overrides[key] } : node);

if (query.includes("query PendingReviewTarget")) {
	const data = process.env.FAKE_GH_CONTRIBUTIONS ? JSON.parse(readFileSync(process.env.FAKE_GH_CONTRIBUTIONS, "utf8")) : {};
	const { files, ...node } = data.reviewTargets?.[`${v.owner}/${v.name}#${v.number}`] ?? {};
	out({ data: { repository: { pullRequest: Object.keys(node).length ? node : null } } });
}
if (query.includes("query ContributionsOwnPr")) {
	const data = process.env.FAKE_GH_CONTRIBUTIONS ? JSON.parse(readFileSync(process.env.FAKE_GH_CONTRIBUTIONS, "utf8")) : {};
	out({ data: { repository: { pullRequest: data.ownPrs?.[`${v.owner}/${v.name}#${v.number}`] ?? null } } });
}
if (query.includes("query ContributionsSearch") || query.includes("query ContributionsItem")) {
	const data = process.env.FAKE_GH_CONTRIBUTIONS ? JSON.parse(readFileSync(process.env.FAKE_GH_CONTRIBUTIONS, "utf8")) : { searches: [], items: {} };
	if (query.includes("query ContributionsItem")) {
		const node = data.items?.[`${v.owner}/${v.name}#${v.number}`] ?? null;
		if (!node) fail(`Could not resolve to an item with the number of ${v.number}.`, { repository: null });
		const field = { PullRequest: "pullRequest", Issue: "issue", Discussion: "discussion" }[node.__typename];
		out({ data: { repository: { [field]: node } } });
	}
	const hit = (data.searches ?? []).find((s) => String(v.q).includes(s.match));
	const all = hit?.nodes ?? [];
	const from = v.after ? Number(v.after) : 0;
	const nodes = all.slice(from, from + (v.first ?? 25));
	const end = from + nodes.length;
	const total = hit?.total ?? all.length;
	out({ data: { search: { issueCount: total, discussionCount: total, pageInfo: { hasNextPage: end < all.length, endCursor: String(end) }, nodes } } });
}
if (/projectsV2|projectItems/.test(query) && process.env.FAKE_GH_NO_PROJECTS === "1") {
	fail("Your token has not been granted the required scopes to execute this query. The 'projectsV2' field requires one of the following scopes: ['read:project'], but your token has only been granted the: ['repo'] scopes.", undefined);
}
if (query.includes("projectsV2(first: 1)")) repository({ projectsV2: { totalCount: 1 } });

// The reads of the link from an escalated discussion's fix PRs to its issue
if (query.includes("resultComments")) {
	const d = overrides[`escalation-${v.number}`];
	if (!d) fail(`Could not resolve to a Discussion with the number of ${v.number}.`, { repository: { discussion: null } });
	repository({ discussion: d });
}
if (query.includes("escalatedIssue")) {
	const issue = overrides[`escalated-issue-${v.number}`];
	if (!issue) fail(`Could not resolve to an Issue with the number of ${v.number}.`, { repository: { escalatedIssue: null } });
	repository({ escalatedIssue: issue });
}
if (query.includes("closingIssuesReferences(first: 50)")) {
	const pr = overrides[`link-pr-${v.number}`];
	if (!pr) fail(`Could not resolve to a PullRequest with the number of ${v.number}.`, { repository: { pullRequest: null } });
	repository({ pullRequest: pr });
}

// The PR a review request for the maintainer reads: its author, its draft flag and the pending review requests
if (query.includes("reviewRequests(first:") && query.includes("user(login: $me)")) {
	const item = gh.issuesAndPrs[v.number];
	if (!item || item.__typename !== "PullRequest") fail(`Could not resolve to a PullRequest with the number of ${v.number}.`, { repository: { pullRequest: null }, user: null });
	const { id, url, state, isDraft } = item;
	const pr = { id, url, state, isDraft, author: { login: gh.prAuthors[v.number] ?? "hubot" }, reviewRequests: { nodes: [] }, ...overrides[`requests-${v.number}`] };
	out({ data: { repository: { pullRequest: pr }, user: gh.users[v.me] ? { id: gh.users[v.me] } : null } });
}
if (query.includes("issueOrPullRequest(number")) {
	const item = gh.issuesAndPrs[v.number];
	if (!item) fail(`Could not resolve to an issue or pull request with the number of ${v.number}.`, { repository: { issueOrPullRequest: null } });
	repository({ issueOrPullRequest: item });
}
if (/label\(name:/.test(query)) {
	const data = {};
	for (const [k, name] of Object.entries(v).filter(([k]) => /^n\d+$/.test(k))) {
		data["l" + k.slice(1)] = gh.labels[name] ? { id: gh.labels[name], name } : null;
	}
	repository(data);
}
if (/user\(login:/.test(query)) {
	const data = {};
	for (const [k, login] of Object.entries(v).filter(([k]) => /^l\d+$/.test(k))) {
		if (!gh.users[login]) fail(`Could not resolve to a User with the login of '${login}'.`, {});
		data["u" + k.slice(1)] = { id: gh.users[login] };
	}
	out({ data });
}
if (/repository\(owner: \$owner, name: \$name\) \{ id \}/.test(query)) {
	if (!gh.repos[v.name]) fail(`Could not resolve to a Repository with the name '${v.owner}/${v.name}'.`, { repository: null });
	repository({ id: gh.repos[v.name] });
}
if (query.includes("node(id: $id)")) {
	const node = gh.nodes[v.id];
	if (!node) fail(`Could not resolve to a node with the global id of '${v.id}'`, { node: null });
	out({ data: { node } });
}
if (query.includes("search(query: $q, type: ISSUE")) {
	if (!/^repo:acme\/widgets is:pr\b/.test(v.q ?? "")) fail(`fake gh only searches PRs of acme/widgets, not "${v.q}"`, undefined);
	out({ data: { search: { nodes: overrides.searchPrs ?? gh.searchPrs } } });
}
if (query.includes("pullRequests(states: OPEN")) {
	repository({ pullRequests: { pageInfo: { hasNextPage: false, endCursor: null }, nodes: Object.values(gh.prNodes).map((n) => withOverride(`pr-${n.number}`, n)) } });
}
if (query.includes("issues(states: OPEN")) {
	const nodes = Object.values(gh.issueNodes).map((n) => withOverride(`issue-${n.number}`, n));
	repository({ issues: { totalCount: gh.openTotals.issues, pageInfo: { hasNextPage: false, endCursor: null }, nodes } });
}
if (query.includes("discussions(states: OPEN")) {
	const nodes = Object.values(gh.discussionNodes).map((n) => withOverride(`disc-${n.number}`, n));
	repository({ discussions: { totalCount: gh.openTotals.discussions, pageInfo: { hasNextPage: false, endCursor: null }, nodes } });
}
if (query.includes("headRepository { nameWithOwner }")) {
	const pr = withOverride(`pr-${v.number}`, gh.apiPrs[v.number]);
	repository({ nameWithOwner: `${gh.OWNER}/${gh.REPO}`, defaultBranchRef: { name: "main" }, pullRequest: pr ?? null });
}
if (query.includes("file(path:")) {
	const tree = { ...gh.files[v.sha], ...overrides.files };
	if (!gh.files[v.sha]) repository({ object: null });
	const blobOid = (text) => createHash("sha1").update(`blob ${Buffer.byteLength(text)}\u0000`).update(text).digest("hex");
	const commit = {};
	for (const [k, path] of Object.entries(v).filter(([k]) => /^p\d+$/.test(k))) {
		const f = tree[path];
		const blob = f && f.type === undefined ? { oid: f.oid ?? blobOid(f.text ?? ""), isBinary: f.binary === true, isTruncated: f.truncated === true, text: f.binary ? null : f.text } : {};
		commit["f" + k.slice(1)] = f ? { mode: f.mode ?? 0o100644, type: f.type ?? "blob", object: blob } : null;
	}
	repository({ object: commit });
}
if (query.includes("pullRequest(number: $number)")) {
	// The answer to a format offer: overrides name it as "offer-<number>"
	if (query.includes("offerReviews")) {
		const node = gh.prNodes[v.number];
		if (!node) fail(`Could not resolve to a PullRequest with the number of ${v.number}.`, { repository: { pullRequest: null } });
		repository({ pullRequest: { state: "OPEN", headRefOid: node.headRefOid, maintainerCanModify: node.maintainerCanModify ?? false, offerReviews: { nodes: [] }, offerComments: { nodes: [] }, reviewRequestEvents: { nodes: [] }, ...overrides[`pr-${v.number}`], ...overrides[`offer-${v.number}`] } });
	}
	// Every changed file of a PR, two per page. A node's `allFiles` holds the ones beyond its first page
	if (query.includes("files(first: 100, after: $after)")) {
		const node = withOverride(`pr-${v.number}`, gh.prNodes[v.number]);
		if (!node) fail(`Could not resolve to a PullRequest with the number of ${v.number}.`, { repository: { pullRequest: null } });
		const all = node.allFiles ?? node.files.nodes;
		const start = Number(v.after ?? 0);
		repository({ pullRequest: { files: { totalCount: all.length, pageInfo: { hasNextPage: start + 2 < all.length, endCursor: String(start + 2) }, nodes: all.slice(start, start + 2) } } });
	}
	if (query.includes("allReviews")) {
		const node = withOverride(`pr-${v.number}`, gh.prNodes[v.number]);
		if (!node) fail(`Could not resolve to a PullRequest with the number of ${v.number}.`, { repository: { pullRequest: null } });
		repository({ pullRequest: node });
	}
	const item = gh.issuesAndPrs[v.number];
	if (!item || item.__typename !== "PullRequest") fail(`Could not resolve to a PullRequest with the number of ${v.number}.`, { repository: { pullRequest: null } });
	repository({ pullRequest: { state: item.state, headRefOid: item.headRefOid, comments: { nodes: [] }, reviews: { nodes: [] } } });
}
if (query.includes("issue(number: $number)")) {
	if (query.includes("closedByPullRequestsReferences")) {
		const node = withOverride(`issue-${v.number}`, gh.issueNodes[v.number]);
		if (!node) fail(`Could not resolve to an Issue with the number of ${v.number}.`, { repository: { issue: null } });
		repository({ issue: node });
	}
	const item = gh.issuesAndPrs[v.number];
	if (!item || item.__typename !== "Issue") fail(`Could not resolve to an Issue with the number of ${v.number}.`, { repository: { issue: null } });
	repository({ issue: { state: item.state, stateReason: null, comments: { nodes: [] } } });
}
if (query.includes("discussion(number: $number)")) {
	if (query.includes("isAnswered")) {
		const node = withOverride(`disc-${v.number}`, gh.discussionNodes[v.number]);
		if (!node) fail(`Could not resolve to a Discussion with the number of ${v.number}.`, { repository: { discussion: null } });
		repository({ discussion: node });
	}
	const d = gh.discussions[v.number];
	if (!d) fail(`Could not resolve to a Discussion with the number of ${v.number}.`, { repository: { discussion: null } });
	if (query.includes("category")) repository({ discussion: d });
	repository({ discussion: { closed: d.closed, comments: { nodes: [] } } });
}
// The state of fix PRs that left the open PRs, one alias per PR
if (query.includes("query EndedFixes")) {
	const numbers = [...query.matchAll(/p(\d+): pullRequest/g)].map((m) => Number(m[1]));
	repository(Object.fromEntries(numbers.map((n) => [`p${n}`, overrides[`ended-${n}`] ?? (gh.issuesAndPrs[n]?.__typename === "PullRequest" ? { state: gh.issuesAndPrs[n].state } : null)])));
}
fail(`fake gh has no answer for this query: ${query.slice(0, 120)}`, undefined);
