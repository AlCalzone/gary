{
	"name": "widgets",
	"repo": "acme/widgets",
	"maintainers": ["octocat"],
	"botLogins": ["widgets-bot"],
	"reviewBots": ["copilot"],
	"relatedRepos": ["widgets-desktop"],
	"sensitivePaths": [".github/**", "**/package.json"],
	"autoLabels": ["needs-info"],
	"botCommands": { "escalate": "@widgets-bot escalate", "automerge": "@widgets-bot automerge" },
	"escalateResult": "^Escalated to an issue: #(\\d+)",
	"requiredTools": [],
	"autofixCommands": ["npx prettier --write --ignore-unknown {files}", "npx eslint --fix {files}"],
	"autofixSetup": "ln -s {checkout}/node_modules node_modules",
	"commitFormat": "conventional"
}
