#!/usr/bin/env node
// The one entry point for everything the skills and the maintainer run. `gary help` lists the commands.
// `--instance <name>` picks the instance, before or after the command.
import { SettingsError, instanceName, paths, setInstance } from "../scripts/lib/config.mjs";

// Each entry: module, exported function, help text
const COMMANDS = {
	snapshot: ["../scripts/snapshot.mjs", "main", "Fetch open items and print the work list. --commit saves the staged snapshot"],
	item: ["../scripts/snapshot.mjs", "itemMain", "Print the fresh snapshot entry of one item: item <id> | item <pr|issue|discussion> <number> [--repo <owner/name>]"],
	put: ["../scripts/board-put.mjs", "main", "Write one board document: put items <id> <file> | items <id> --delete | meta <file> | proposals <id> <file> | learn <file>. --merge, --no-validate"],
	validate: ["../scripts/validate.mjs", "main", "Check board items against the rules: validate [<id> ...]. Read-only"],
	action: ["../scripts/execute-action.mjs", "main", "Run one GitHub action from a JSON file or stdin. --dry-run, --check-fresh, --autonomous"],
	decisions: ["../scripts/learn-cli.mjs", "decisionsMain", "Print the decision log. --since <ISO> (exclusive), --json"],
	proposals: ["../scripts/learn-cli.mjs", "proposalsMain", "List the rule proposals with their status. --json"],
	pause: ["../scripts/lib/control.mjs", "pauseMain", "Stop every GitHub write and every queued agent start until resume. --all"],
	resume: ["../scripts/lib/control.mjs", "resumeMain", "End a pause. --all"],
	instances: ["../scripts/instances.mjs", "main", "List the instances and mark the one this directory resolves to. --json"],
	serve: ["../scripts/serve.mjs", "main", "Start the one board server for every instance. --watch, --dry-run"],
	migrate: ["../scripts/migrate.mjs", "main", "Move instances to the single-server layout. Safe to run again"],
	"watch-queue": ["../scripts/watch-queue.mjs", "main", "Print queued agent requests as JSON lines. --all, --once"],
	setup: ["../scripts/setup.mjs", "main", "Create an instance with its config.json. --help for the flags"],
	doctor: ["../scripts/doctor.mjs", "main", "Check the installation, read-only. --json, --all"],
};
// These change state, so they name the instance first on stderr. pause, resume and setup name it themselves
const ANNOUNCED = new Set(["snapshot", "put", "action"]);

function help() {
	const lines = ["Usage: gary [--instance <name>] <command> [options]", ""];
	for (const [name, [, , text]] of Object.entries(COMMANDS)) lines.push(`  ${name.padEnd(12)} ${text}`);
	lines.push(`  ${"paths".padEnd(12)} Print the instance, root, home, config, personal, profile, state, checkout and core paths as JSON. --root: only core and root`);
	console.log(lines.join("\n"));
}

/** Takes `--instance <name>` or `--instance=<name>` out of the arguments, wherever it stands. */
function takeInstance(argv) {
	const rest = [];
	let name = null;
	for (let i = 0; i < argv.length; i++) {
		if (argv[i] === "--instance") name = argv[++i] ?? "";
		else if (argv[i].startsWith("--instance=")) name = argv[i].slice(11);
		else rest.push(argv[i]);
	}
	return { name, rest };
}

const { name, rest } = takeInstance(process.argv.slice(2));
if (name !== null) setInstance(name);
const [command, ...args] = rest;
try {
	if (!command || command === "help" || command === "--help" || command === "-h") {
		help();
	} else if (command === "paths") {
		if (args.includes("--root")) {
			const { core, root } = paths();
			console.log(JSON.stringify({ core, root }, null, 2));
		} else {
			const out = paths();
			console.log(JSON.stringify(out, null, 2));
			if (out.error) process.exitCode = 2;
		}
	} else if (Object.hasOwn(COMMANDS, command)) {
		if (ANNOUNCED.has(command)) console.error(`Instance ${instanceName()}.`);
		const [module, fn] = COMMANDS[command];
		await (await import(module))[fn](args);
	} else {
		console.error(`Unknown command "${command}".`);
		help();
		process.exitCode = 2;
	}
} catch (e) {
	console.error(`gary ${command}: ${e.message}`);
	process.exitCode = e instanceof SettingsError ? 2 : 1;
}
